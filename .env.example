# Axiodrasil Core — 环境变量示例
# 复制为 .env 后填入真实密钥

# ── 主聊天 LLM（默认 DeepSeek）──────────────────────────
AX_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AX_CHAT_MODEL=deepseek-v4-flash
AX_ENRICHMENT_MODEL=deepseek-v4-flash
# DeepSeek V4 thinking：0=关闭（默认，省钱省延迟） 1=开启
AX_DEEPSEEK_THINKING=0

# 回退千问主聊天时：
# AX_LLM_PROVIDER=qwen
# AX_CHAT_MODEL=qwen-plus
# AX_ENRICHMENT_MODEL=qwen-turbo

# ── Embedding（仍用 DashScope / 千问，与聊天 provider 解耦）──
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 可选 Redis 会话热缓存 ───────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── 记忆注入预算（可选）────────────────────────────────
# AX_DEBATE_INJECT_MAX_CHARS=2400
# AX_CONSENSUS_INJECT_MAX_CHARS=1000
# AX_PERSONA_PRIVATE_MAX_CHARS=800
# AX_DEBATE_BUFFER_TURNS=30

# ── 可选 Rerank ───────────────────────────────────────
# JINA_API_KEY=
# RERANK_PROVIDER=jina

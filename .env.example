# Axiodrasil Core — 环境变量示例
# 复制为 .env 后填入真实密钥

# ── 主聊天 LLM（默认 DeepSeek）──────────────────────────
AX_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AX_CHAT_MODEL=deepseek-v4-flash
# DeepSeek V4 thinking：0=关闭（默认，省钱省延迟） 1=开启
AX_DEEPSEEK_THINKING=0

# ── Bina Hindsight 长期记忆 ─────────────────────────────
# 本地单用户 API 的稳定记忆身份。浏览器已有 x-memory-thread 时沿用该身份。
AX_MEMORY_USER_ID=bina-local-user
AX_HINDSIGHT_URL=http://127.0.0.1:8888
# 连接启用认证的已有服务时填写；本地 Compose 默认无需填写。
AX_HINDSIGHT_API_KEY=
# Compose 默认复用上面的 DEEPSEEK_API_KEY，无需另填密钥。
HINDSIGHT_API_LLM_PROVIDER=deepseek
HINDSIGHT_API_LLM_MODEL=deepseek-chat
HINDSIGHT_API_LLM_BASE_URL=https://api.deepseek.com
# HINDSIGHT_API_LLM_API_KEY=
# 若使用 Qwen，改 provider=openai，并设置模型、DashScope base URL 与此独立密钥。

# ── 人格正/负向风格提示（可选；覆盖 prompts/steering/{persona}.json）──
# AX_BINA_POSITIVE_PROMPT=短气泡，先站队，口语自然
# AX_BINA_NEGATIVE_PROMPT=结构化安慰文；代写话术；晚饭热汤收尾

# 回退千问主聊天时：
# AX_LLM_PROVIDER=qwen
# AX_CHAT_MODEL=qwen-plus

# ── 图片描述和语音转写 ──────────────────────────────
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Solo 图片描述 / 服务端 STT（复用 QWEN_API_KEY）
# AX_VL_MODEL=qwen-vl-plus
# AX_STT_MODEL=qwen2-audio-instruct

# ── Bina 定妆出图（本地 ComfyUI + 角色 LoRA，邻舍同款引擎）──
# AX_IMAGE_GEN_ENABLED=1
# AX_COMFYUI_URL=http://127.0.0.1:8188
# AX_COMFYUI_CKPT=sd_xl_base_1.0.safetensors
# 将 LoRA 放到 ComfyUI/models/loras/，并编辑 config/persona_visual/bina.json
# AX_BINA_LORA=bina.safetensors
# AX_BINA_LORA_TRIGGER=bina_char
# AX_BINA_LORA_WEIGHT=0.85
# AX_COMFYUI_WIDTH=832
# AX_COMFYUI_HEIGHT=1216
# AX_IMAGE_OUT_DIR=data/generated


# ── SQLite 库路径（强烈建议固定到本机盘）────────────────
# 启动器 / scripts/dev_stack.ps1 默认：
#   %USERPROFILE%\.axiodrasil\axiodrasil_core.db
# 未设置时回退到仓库 data/axiodrasil_core.db（WSL UNC 上易锁死）。
# AX_DB_PATH=C:\Users\你\.axiodrasil\axiodrasil_core.db

# ── Next BFF 后端地址（仅 frontend/.env.local）──────────
# BACKEND_URL=http://127.0.0.1:8000

# ── Bina 主动找你（托盘常驻心跳）──────────────────────
# AX_PROACTIVE_ENABLED=1
# AX_PROACTIVE_INTERVAL_SEC=300
# AX_PROACTIVE_COOLDOWN_MIN=45
# 安静时段（本地小时，默认 0–8 点不主动开口）
# AX_PROACTIVE_QUIET_START=0
# AX_PROACTIVE_QUIET_END=8
# 情绪阈值（积温简化）
# AX_MOOD_CONTACT_THRESHOLD=0.35
# AX_MOOD_FORCE_CONTACT_THRESHOLD=0.50
# AX_MOOD_PRIDE_BLOCK=0.50
# AX_INTERACTION_HOOKS_ENABLED=1
